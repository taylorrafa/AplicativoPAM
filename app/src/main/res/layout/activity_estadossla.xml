res/layout/activity_main.xml
    <?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cidades do Brasil"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />
    <TextView
        android:id="@+id/txtRotuloEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha o estado:"
        android:textSize="16sp" />
    <Spinner
        android:id="@+id/spnEstados"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp" />
    <ProgressBar

    android:id="@+id/prbCarregando"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:visibility="gone" />
    <TextView
        android:id="@+id/txtQuantidade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nenhum estado selecionado"
        android:textSize="14sp"
        android:textStyle="italic"
        android:layout_marginBottom="8dp" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvCidades"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>